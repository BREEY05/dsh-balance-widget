{
  "name": "@breey05/dsh-balance-widget",
  "version": "1.4.1",
  "scripts": { "test": "node switching.test.mjs" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "description": "Provider-aware API balance and observed spend that follow the selected Harness model.",
  "repository": { "type": "git", "url": "git+https://github.com/BREEY05/dsh-balance-widget.git" },
  "homepage": "https://github.com/BREEY05/dsh-balance-widget#readme",
  "bugs": { "url": "https://github.com/BREEY05/dsh-balance-widget/issues" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": ["switching.test.mjs", "scripts/probe-provider.mjs", "index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "taffy", "balance", "spend", "usage"],
  "engines": { "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-chat"]
    }
  }
}
